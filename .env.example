# Use the existing project's URL and publishable key (never a service-role key).
# Auth runs only on the server; these values do not need NEXT_PUBLIC_ prefixes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Server-only Task feature. Never prefix these with NEXT_PUBLIC_.
GEMINI_API_KEY=
GEMINI_TASK_MODEL=gemini-3.5-flash
# Task generation/review falls back to Groq when Gemini fails.
GROQ_API_KEY=
GROQ_TASK_MODEL=openai/gpt-oss-120b
# Dedicated non-bypass-RLS login provisioned by scripts/setup-tasks.mjs.
TASK_DATABASE_URL=

# Existing NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY also work.
# Optional, only for the database security test; never used by the app.
# SUPABASE_DB_URL=
