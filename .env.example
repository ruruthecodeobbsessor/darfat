# Use the existing project's URL and publishable key (never a service-role key).
# Auth runs only on the server; these values do not need NEXT_PUBLIC_ prefixes.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Existing NEXT_PUBLIC_SUPABASE_URL + NEXT_PUBLIC_SUPABASE_ANON_KEY also work.
# Optional, only for the database security test; never used by the app.
# SUPABASE_DB_URL=
