# Supabase project URL and publishable key (never use a service-role key).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=

# Main application PostgreSQL connection. URL-encode special password characters.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/postgres
# Optional alias used by database setup scripts.
SUPABASE_DB_URL=

# Server-only AI configuration.
GEMINI_API_KEY=
GEMINI_TASK_MODEL=gemini-3.5-flash
GROQ_API_KEY=
GROQ_TASK_MODEL=openai/gpt-oss-120b

# Dedicated non-bypass-RLS login provisioned by scripts/setup-tasks.mjs.
TASK_DATABASE_URL=
